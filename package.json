{
  "name": "exterm-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "cli": "npm run start --workspace=@exterm/cli",
    "dev:trainer": "uv run --directory trainer python -m exterm_trainer"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "playwright": "^1.62.1",
    "typescript": "^5.4.5"
  }
}
